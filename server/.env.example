# Server Environment Variables Configuration
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/collabhub?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=7d
MAX_UPLOAD_BYTES=10485760
# Private local development storage; keep outside any static/public directory.
LOCAL_UPLOAD_DIR=./private-uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to the number of trusted reverse proxies in front of the API (often 1).
TRUST_PROXY_HOPS=0
# Optional OpenAI-compatible chat-completions endpoint; key stays on backend.
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
# Optional Jitsi JWT auth configuration. Provider-side JWT auth must be enabled.
JITSI_DOMAIN=
JITSI_APP_ID=
JITSI_APP_SECRET=
